PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

JWT_SECRET=change-me-user-jwt
JWT_ADMIN_SECRET=change-me-admin-jwt
JWT_EMAIL_VERIFY_SECRET=change-me-email-verify

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=roofstead

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@roofstead.example
MAIL_ENABLED=false

APP_NAME=RoofStead
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# When router DNS fails (ENOTFOUND api.airtable.com), Node uses these resolvers in development.
# Set on production only if needed: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=1.1.1.1,8.8.8.8

# Profile photos: local disk in dev (fast). Set CLOUDINARY_UPLOAD=true to use Cloudinary.
# PROFILE_UPLOAD_LOCAL=true forces local disk even in production.
PROFILE_UPLOAD_LOCAL=

# Super admin (npm run seed:admin)
SUPER_ADMIN_EMAIL=admin@roofstead.local
SUPER_ADMIN_PASSWORD=ChangeMe-SuperAdmin-123!
SUPER_ADMIN_NAME=Super Admin
